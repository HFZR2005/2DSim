---
export const prerender = false;

const path = Astro.params.path ?? '';
if (path === 'login' || path.startsWith('login/')) {
  return Astro.redirect(`/login${Astro.url.search}`);
}
if (path === 'log' || path.startsWith('log/')) {
  return Astro.redirect(`/log${Astro.url.search}`);
}
if (path === 'topics' || path.startsWith('topics/')) {
  return Astro.redirect(`/subjects${Astro.url.search}`);
}
if (path === 'subjects' || path.startsWith('subjects/')) {
  return Astro.redirect(`/subjects${Astro.url.search}`);
}
if (path === 'history' || path.startsWith('history/')) {
  return Astro.redirect(`/history${Astro.url.search}`);
}
if (path === 'people' || path.startsWith('people/')) {
  return Astro.redirect(`/people${Astro.url.search}`);
}
return Astro.redirect(`/${path}${Astro.url.search}`);
---
