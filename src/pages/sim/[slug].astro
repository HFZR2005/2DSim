---
import Simulator from '../../components/Simulator.astro';
import { availableScenarios, getScenario, scenarios } from '../../catalog/scenarios';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConnectedExplanation from '../../scenarios/connected-particles/Explanation.astro';
import ConnectedWorkedExample from '../../scenarios/connected-particles/WorkedExample.astro';
import LadderExplanation from '../../scenarios/ladder-against-wall/Explanation.astro';
import LadderWorkedExample from '../../scenarios/ladder-against-wall/WorkedExample.astro';
import LiftExplanation from '../../scenarios/lift/Explanation.astro';
import LiftWorkedExample from '../../scenarios/lift/WorkedExample.astro';
import ProjectileExplanation from '../../scenarios/projectile-motion/Explanation.astro';
import ProjectileWorkedExample from '../../scenarios/projectile-motion/WorkedExample.astro';
import PulleyExplanation from '../../scenarios/two-particle-pulley/Explanation.astro';
import PulleyWorkedExample from '../../scenarios/two-particle-pulley/WorkedExample.astro';
import VariableExplanation from '../../scenarios/variable-acceleration/Explanation.astro';
import VariableWorkedExample from '../../scenarios/variable-acceleration/WorkedExample.astro';

export function getStaticPaths() {
  return availableScenarios().map((scenario) => ({
    params: { slug: scenario.slug },
  }));
}

const slug = Astro.params.slug;
const scenario = slug ? getScenario(slug) : undefined;

if (!scenario || scenario.status !== 'available') {
  return Astro.redirect('/');
}

const copy = {
  'two-particle-pulley': {
    Explanation: PulleyExplanation,
    WorkedExample: PulleyWorkedExample,
  },
  'connected-particles': {
    Explanation: ConnectedExplanation,
    WorkedExample: ConnectedWorkedExample,
  },
  'ladder-against-wall': {
    Explanation: LadderExplanation,
    WorkedExample: LadderWorkedExample,
  },
  'projectile-motion': {
    Explanation: ProjectileExplanation,
    WorkedExample: ProjectileWorkedExample,
  },
  lift: {
    Explanation: LiftExplanation,
    WorkedExample: LiftWorkedExample,
  },
  'variable-acceleration': {
    Explanation: VariableExplanation,
    WorkedExample: VariableWorkedExample,
  },
}[scenario.slug];

if (!copy) {
  return Astro.redirect('/');
}

const { Explanation, WorkedExample } = copy;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: scenario.title,
  description: scenario.description,
  dateModified: scenario.dateModified,
};
---

<BaseLayout title={`2DSim — ${scenario.title}`} description={scenario.description} jsonLd={jsonLd}>
  <Simulator scenario={scenario} catalog={scenarios}>
    <Explanation slot="explanation" />
    <WorkedExample slot="worked-example" />
  </Simulator>
</BaseLayout>
