---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout title="2DSim — Not found">
  <div class="library">
    <header class="sim-header">
      <a class="wordmark" href="/lab">2DSim</a>
      <span>Not found</span>
    </header>
    <main class="library-main">
      <p class="library-empty is-visible">No such experiment. <a href="/lab">Return to the lab</a>.</p>
    </main>
  </div>
</BaseLayout>
