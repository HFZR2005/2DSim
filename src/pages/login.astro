---
import { getGoogleOAuth } from '../study/env';
import '../study/app/styles.css';

export const prerender = false;

const requested = Astro.url.searchParams.get('next') ?? '/';
const next = requested.startsWith('/') && !requested.startsWith('//') ? requested : '/';
const error = Astro.url.searchParams.get('error');

let googleEnabled = false;
try {
  googleEnabled = Boolean(getGoogleOAuth());
} catch {
  googleEnabled = false;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>Study Tracker — Sign in</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="study-login-body">
    <main class="study-login">
      <h1>Study Tracker</h1>
      <p>
        {
          googleEnabled
            ? 'Sign in with Google. Students and supervisors set up their own accounts.'
            : 'Google sign-in is not configured yet.'
        }
      </p>
      {
        googleEnabled && (
          <a class="google-btn" href={`/api/study/auth/google?next=${encodeURIComponent(next)}`}>
            Continue with Google
          </a>
        )
      }
      <p id="study-login-error" class="study-error" hidden={!error}>{error}</p>
    </main>
  </body>
</html>
